@page "/rentals/browser"
@rendermode InteractiveServer
@using RentIT.BlazorFrontend.Models.Rentals

<BasePageContent>
    <PageHead PageHeader="Dostępny sprzęt" PrompText=@($"Pozycje // {_positionNum}")>
        <NavLink href="/rentals/create" class="btn btn-primary">+ Dodaj wynajem</NavLink>
    </PageHead>
    <SearchBar OnSearchClicked="HandleSearch"/>
    
    <div class="row mt-3">
        <div class="col-md-3">
            <h3>Filters</h3>
        </div>
        <div class="col-md-9">
            <div class="row g-3">
                @foreach(var item in Items)
                {
                    <div class="col-md-4">
                        <RentalCard Model="@item"/>
                    </div>
                }
            </div>
        </div>
    </div>
</BasePageContent>


        new() { Money = new() {Amount = 15, CurrencyCode = "PLN"}, CategoryName = "laptopy", Id = Guid.NewGuid(),  Status = "dostepny", Name = "Dell Latitude 5540 i7/16GB" },
        new() { Money = new() {Amount = 15, CurrencyCode = "PLN"}, CategoryName = "laptopy", Id = Guid.NewGuid(), CoverImageUrl = "https://placehold.co/600x400/png", Status = "dostepny", Name = "Dell Latitude 5540 i7/16GB" },
    };

    public async Task HandleSearch(string phrase)
    {

    }

    public void ToggleRentalSelect(RentalBrowserItemViewModel vm)
    {
        if (SelectedRentals.Contains(vm))
            SelectedRentals.Remove(vm);
        else
            SelectedRentals.Add(vm);
    }

}

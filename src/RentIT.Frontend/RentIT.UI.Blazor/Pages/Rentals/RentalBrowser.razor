@page "/rentals/browser"
@rendermode InteractiveServer
@using RentIT.BlazorFrontend.Models.Rentals
@using RentIT.BlazorFrontend.Pages.Rentals.Components

<BasePageContent>
    <PageHead PageHeader="Dostępny sprzęt" PrompText=@($"Pozycje // {Items.Count}")>
        <NavLink href="/rentals/create" class="btn btn-primary">+ Dodaj wynajem</NavLink>
    </PageHead>
    <SearchBar OnSearchClicked="HandleSearch"/>
    
    <div class="row mt-3">
        <div class="col-md-3">
            <h3>Filters</h3>
        </div>
        <div class="col-md-9">
            <RentalCardContainer Items="@Items"/>
        </div>
    </div>
</BasePageContent>


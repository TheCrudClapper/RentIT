@page "/rentals/browser"
@rendermode InteractiveServer
@using BlazorBootstrap
@using RentIT.BlazorFrontend.Models.Rentals

<BasePageContent>
    <PageHead PageHeader="Dostępny sprzęt" PrompText=@($"Pozycje // {Items.Count}")>
    <Button Type="ButtonType.Link" Color="ButtonColor.Primary" To="/rentals/create">+ Dodaj wynajem</Button>
    </PageHead>
    <SearchBar OnSearchClicked="HandleSearch"/>
    
    <div class="row mt-3">
        <div class="col-md-3">
            <h3>Filters</h3>
        </div>
        <div class="col-md-9">
            <div class="row g-3">
                @foreach (var item in Items)
                {
                    <div class="col-md-4">
                        <RentalCard Model="@item" OnRentalSelected="sex => ToggleRentalSelect(sex)"/>
                    </div>
                }
            </div>
        </div>
    </div>
</BasePageContent>

@code {
    private bool _sideCartPanelOpen { get; set; }
    private List<RentalBrowserItemViewModel> SelectedRentals = new();
    private List<RentalBrowserItemViewModel> Items = new()
    {
        new() { Money = new() {Amount = 15, CurrencyCode = "PLN"}, CategoryName = "laptopy", Id = Guid.NewGuid(), CoverImageUrl = "https://placehold.co/600x400/png", Status = "dostepny", Name = "Dell Latitude 5540 i7/16GB", },

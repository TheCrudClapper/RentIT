@using RentIT.BlazorFrontend.Models.Equipments
@using RentIT.BlazorFrontend.Models.Shared
@using RentIT.UI.Contracts.DTO.EquipmentMicroservice.Enums

<EditForm OnValidSubmit="OnValidSubmit" FormName="EquipmentAddForm" Model="@Model">
    <DataAnnotationsValidator />
    <div class="field">
        <label for="name">Name</label>

        <InputText id="name"
                   type="text"
                   @bind-Value="Model.Name"
                   placeholder="Dell Latitude" />

        <ValidationMessage For="@(() => Model.Name)" />
    </div>

    <div class="field">
        <label for="category">Category</label>
        <InputSelect @bind-Value="Model.CategoryId">
            <option disabled="disabled" selected>-- Pick Category --</option>
            @if (Categories.Count != 0)
            {
                foreach (var cat in Categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            }
        </InputSelect>
        <ValidationMessage For="@(() => Model.CategoryId)" />
    </div>

     <div class="field">
        <label for="quantity">Quantity</label>
        <InputNumber @bind-Value="Model.Quantity"/>
        <ValidationMessage For="@(() => Model.Quantity)" />
    </div>

    <div class="field">
        <label for="status">Condition</label>
        <select id="status" @bind="Model.Condition">
            @foreach (var status in Statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
        <ValidationMessage For="@(() => Model.Condition)" />
    </div>

    <div class="field">
        <label for="description">Description</label>
        <InputTextArea id="description" @bind-Value="Model.Description" />
        <ValidationMessage For="@(() => Model.Description)" />
    </div>

    <div class="field">
        <label for="notes">Notes</label>

        <InputTextArea id="notes"
                       type="text"
                       @bind-Value="Model.InternalNotes"
                       placeholder="Your notes here" />
        <ValidationMessage For="@(() => Model.InternalNotes)" />
    </div>

    <button type="submit" class="btn btn-primary">
       Zatwierdz
    </button>

</EditForm>


@code {
    [Parameter] public UserEquipmentFormModel Model { get; set; }
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public EventCallback<UserEquipmentFormModel> OnSubmit { get; set; }
    [Parameter] public List<BaseDropdownModel> Categories { get; set; } = [];
    private List<EquipmentCondition> Statuses = new();

    protected override void OnInitialized()
    {
        PopulateStatuses();
    }

    public async Task OnValidSubmit()
    {
        await OnSubmit.InvokeAsync(Model);
    }

    private void PopulateStatuses()
    {
        Statuses = Enum.GetValues(typeof(EquipmentCondition)).Cast<EquipmentCondition>().ToList();
    }
}
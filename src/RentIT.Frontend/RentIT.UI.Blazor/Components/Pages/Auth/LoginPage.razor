@page "/login"
@rendermode InteractiveServer
@layout AuthLayout
@inject IAuthenticationService authService
@inject IAuthHttpClient authHttpClient
@inject NavigationManager navigationManager

<PageTitle>Logowanie</PageTitle>

<div class="eyebrow">Logowanie</div>
<h2>Wejdź na konto</h2>

<EditForm Model="@Model" OnValidSubmit="HandleSubmit" FormName="loginForm">
    <DataAnnotationsValidator />
    <div class="field">
        <label>Adres e-mail</label>
        <InputText @bind-Value="Model.Email" placeholder="jan.kowalski@it-dzial.pl"/>
        <ValidationMessage For="@(() => Model.Email)" />
    </div>
    <div class="field">
        <label>Hasło</label>
        <InputText type="password" placeholder="••••••••••" @bind-Value="Model.Password" />
        <ValidationMessage For="@(() => Model.Password)" />
    </div>
    <div class="form-foot">
        <label style="display:flex; align-items:center; gap:8px; text-transform:none; font-size:13px;"><input type="checkbox">Zapamiętaj mnie</label>
        <a href="#">Nie pamiętam hasła</a>
    </div>
    <button type="submit" class="btn btn-primary">Zaloguj się</button>
    <span>@Message</span>
</EditForm>


<div class="form-foot" style="justify-content:center; margin-top:20px;">
    Nie masz konta?
    <NavLink href="register" class="">
        <span>Zarejestruj się</span>
    </NavLink>
</div>

@code {

    [SupplyParameterFromForm]
    LoginModel Model { get; set; } = new() { Email = string.Empty, Password = string.Empty};
    string Message { get; set; } = string.Empty;

    private async Task HandleSubmit()
    {
        var result = await authHttpClient.LoginAsync(Model.ToDto());
        if (result.IsFailure)
        {
            Message = result.Error.Description;
            return;
        }

        await authService.SignInAsync(result.Value);

        navigationManager.NavigateTo("/");
    }

}

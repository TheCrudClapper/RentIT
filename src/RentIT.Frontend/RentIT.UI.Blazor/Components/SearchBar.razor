<div class="search-bar">
    <InputText type="text" class="input" placeholder="Szukaj sprzętu..." @bind-Value="@SearchPhrase" />
    <button class="btn btn-ghost" @onclick="() => OnSearchClicked.InvokeAsync(SearchPhrase)">Szukaj</button>
</div>
@code {
    [Parameter] public EventCallback<string> OnSearchClicked { get; set; }
    public string SearchPhrase { get; set; }
}

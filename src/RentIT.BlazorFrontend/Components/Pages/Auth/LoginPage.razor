@page "/login"
@layout AuthLayout
@using RentIT.BlazorFrontend.Models.Auth;

<div class="eyebrow">Logowanie</div>
<h2>Wejdź na konto</h2>
<div class="field">
    <label>Adres e-mail</label>
    <input type="email" placeholder="jan.kowalski@it-dzial.pl">
</div>

<EditForm Model="@LoginModel">
    <div class="field">
        <label>Hasło</label>
        <input type="password" placeholder="••••••••••">
    </div>
    <div class="form-foot">
        <label style="display:flex; align-items:center; gap:8px; text-transform:none; font-size:13px;"><input type="checkbox">Zapamiętaj mnie</label>
        <a href="#">Nie pamiętam hasła</a>
    </div>
</EditForm>

<button class="btn btn-primary">Zaloguj się</button>
<div class="form-foot" style="justify-content:center; margin-top:20px;">
    Nie masz konta?
    <NavLink href="register" class="">
        <span>Zarejestruj się</span>
    </NavLink>
</div>

@code {
    LoginModel LoginModel = new();
}

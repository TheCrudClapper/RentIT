@page "/register"
@layout AuthLayout

<div class="eyebrow">Rejestracja</div>
<h2>Utwórz konto</h2>
<div class="field">
    <label>Imie</label>
    <input type="email" placeholder="Jan">
</div>
<div class="field">
    <label>Nazwisko</label>
    <input type="email" placeholder="Kowalski">
</div>
<div class="field">
    <label>Adres e-mail</label>
    <input type="email" placeholder="jan.kowalski@it-dzial.pl">
</div>
<div class="field">
    <label>Hasło</label>
    <input type="password" placeholder="••••••••••">
</div>
<button class="btn btn-primary">Zarejestruj się</button>
<div class="form-foot" style="justify-content:center; margin-top:20px;">
    Masz już konto?
    <NavLink href="login" class="">
        <span>Zaloguj się</span>
    </NavLink>
</div>

